# ─── u-n-me environment variables ──────────────────────────────────────────
# Copy to .env.local for local development, and set the same values in your
# Vercel project (Project → Settings → Environment Variables). Never commit
# real secrets — .env.local is gitignored.

# HMAC signing secret for session tokens. Use a long random string.
# e.g. generate one with:  openssl rand -hex 32
UNME_SECRET="please-change-this-to-a-long-random-string"

# The two accounts, as a JSON array. Names are matched case-insensitively at
# login. If this is UNSET the app falls back to demo accounts so a local build
# doesn't crash — but once UNME_USERS is set, only these credentials work.
# The FIRST account is the teal person ("you"), the second is coral ("partner").
UNME_USERS='[{"id":"a","name":"Shreya","pass":"changeme1"},{"id":"b","name":"Partner","pass":"changeme2"}]'

# Upstash Redis (REST). The Vercel Marketplace Upstash integration usually
# injects the KV_REST_API_* pair automatically; the UPSTASH_REDIS_REST_* pair
# is supported as a fallback. Set ONE of the pairs.
KV_REST_API_URL="https://your-db.upstash.io"
KV_REST_API_TOKEN="your-upstash-rest-token"

# Fallback naming (only needed if KV_REST_API_* are not provided):
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
